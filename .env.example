# ==============================================================================
# Claim4u — Production Environment Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Duplicate this file as '.env' in your local environment.
# 2. Fill in your real GoDaddy credentials and production values.
# 3. NEVER commit the actual '.env' file to your GitHub repository!
# ==============================================================================

# --- Website Brand & Identity ---
APP_NAME="Claim4u"
APP_TAGLINE="YOUR HOUSING CLAIMS PARTNER"
APP_ENV="production"
APP_URL="https://claim4u.co.uk"

# --- Primary Phone & WhatsApp Contact ---
# Standard UK telephone (display and tel: protocol link)
COMPANY_PHONE="07473956657"
COMPANY_PHONE_TEL="tel:07473956657"

# International UK format without '+' (for https://wa.me/ links)
COMPANY_WHATSAPP="447473956657"
COMPANY_WHATSAPP_URL="https://wa.me/447473956657"
COMPANY_EMAIL="info@claim4u.co.uk"

# --- Third-Party APIs ---
# UK Postcodes API for live address & district validation (free service)
POSTCODE_API_URL="https://api.postcodes.io/postcodes/"

# --- Webhook Forwarding (Zapier, Make.com, HubSpot, or Custom CRM) ---
# Paste your webhook URL here to automatically stream all submitted housing claims
WEBHOOK_ENDPOINT=""

# --- GoDaddy cPanel & Hosting Configuration ---
# Your GoDaddy cPanel username (e.g. your GoDaddy Linux hosting user)
GODADDY_CPANEL_USER="your_cpanel_username"

# FTP / SFTP Server hostname (usually your domain or GoDaddy server IP/host)
GODADDY_FTP_HOST="ftp.claim4u.co.uk"
GODADDY_FTP_USER="your_ftp_username"
GODADDY_FTP_PASSWORD="your_ftp_password"

# Target root directory on GoDaddy (default cPanel web root is /public_html)
GODADDY_PUBLIC_PATH="/home/your_cpanel_username/public_html"

# --- GitHub Private Repository Info ---
GITHUB_REPO_OWNER="Talha554-tiger"
GITHUB_REPO_NAME="claim4u"
GITHUB_REPO_URL="https://github.com/Talha554-tiger/claim4u.git"
GITHUB_BRANCH="main"

# --- Optional GoDaddy SMTP Mailer (for server-side notifications) ---
SMTP_HOST="smtp.secureserver.net"
SMTP_PORT=587
SMTP_USER="info@claim4u.co.uk"
SMTP_PASS="your_secure_email_password"
SMTP_SECURE="tls"
NOTIFICATION_RECIPIENT="info@claim4u.co.uk"
